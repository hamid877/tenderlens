# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=TenderLens
DEBUG=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# OpenAI (Milestone 9: Hosted LLM Provider)
# ---------------------------------------------------------------------------
# Required – your OpenAI secret key.  Never commit a real value.
OPENAI_API_KEY=your-openai-api-key-here
# Optional – model passed to the Responses API.  Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
